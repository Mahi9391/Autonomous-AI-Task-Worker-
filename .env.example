# Google Gemini Configuration (via OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Server Ports
WORKER_PORT=8000
COMPANY_APP_PORT=8001
EMAIL_SANDBOX_PORT=8002
DASHBOARD_PORT=5173

# Local Application Base URLs
WORKER_BASE_URL=http://localhost:8000
COMPANY_APP_BASE_URL=http://localhost:8001
EMAIL_SANDBOX_BASE_URL=http://localhost:8002
DASHBOARD_BASE_URL=http://localhost:5173

# Scheduler and Clock Configuration
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_INTERVAL_MINUTES=60
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS=0,1,2,3,4
CLOCK_OVERRIDE=
ENFORCE_BUSINESS_HOURS=false

# Watcher Configuration
WATCHED_FOLDER_PATH=data/watched
WATCHER_STABILIZE_SECONDS=2
